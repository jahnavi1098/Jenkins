sudo yum install -y java-21-amazon-corretto java-21-amazon-corretto-devel

sudo alternatives --set java /usr/lib/jvm/java-21-amazon-corretto.x86_64/bin/java || sudo alternatives --config java
java -version

sudo sed -i 's|^#Environment="JAVA_HOME=.*|Environment="JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto.x86_64"|' /usr/lib/systemd/system/jenkins.service
sudo sed -i 's|^Environment="JAVA_HOME=.*|Environment="JAVA_HOME=/usr/lib/jvm/java-21-amazon-corretto.x86_64"|' /usr/lib/systemd/system/jenkins.service

sudo systemctl daemon-reload
sudo systemctl start jenkins
sleep 10

sudo systemctl status jenkins --no-pager -l
sudo cat /var/lib/jenkins/secrets/initialAdminPassword
